// Minimalistisches Prisma-Schema für Warteliste
// Datei: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Waitlist {
  id    Int    @id @default(autoincrement())
  email String @unique
  createdAt DateTime @default(now())
}
